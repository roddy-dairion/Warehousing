<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848 (LoggerMessage), CA2007 (ConfigureAwait), CA1062 (null args), CA1515 (internal types), CA1711 (suffixes), CA1716/CA1724 (reserved names), CA1819 (array props) are noisy for an ASP.NET app. -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1062;CA1515;CA1711;CA1716;CA1724;CA1819;CA1873</NoWarn>
    <!-- CA1862: EF Core cannot translate string.Contains(..., StringComparison); queries use ToLower().Contains(). -->
    <NoWarn>$(NoWarn);CA1862</NoWarn>
    <!-- CA1304/CA1311: ToLower() appears only inside EF queries, where it is translated to SQL lower() (no .NET culture involved). -->
    <NoWarn>$(NoWarn);CA1304;CA1311</NoWarn>
    <!-- ICU is required to resolve IANA time zone names (e.g. Indian/Mauritius) on Windows; Linux servers need the libicu package. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
