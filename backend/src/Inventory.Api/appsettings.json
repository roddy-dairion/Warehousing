{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "inventory-api",
    "Audience": "inventory-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "WarehouseCode": "MAIN",
    "WarehouseName": "Main warehouse"
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "RefreshPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "App_Data/files"
  }
}
