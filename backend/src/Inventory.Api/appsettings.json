{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "inventory-api",
    "Audience": "inventory-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "WarehouseCode": "MAIN",
    "WarehouseName": "Main warehouse"
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "RefreshPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "App_Data/files"
  },
  "Inventory": {
    "RequireDifferentApprover": true,
    "ExpiryAlertDays": 30,
    "MinShelfLifeDays": 0,
    "IdempotencyRetentionHours": 48,
    "MaintenanceEnabled": true,
    "ReconciliationIntervalHours": 24
  },
  "Dispatch": {
    "RequireDifferentApprover": true,
    "AllowPartialShipment": true,
    "MinDeliveryPhotos": 1,
    "MaxDeliveryPhotos": 10,
    "MaxPhotoMegabytes": 10
  },
  "Documents": {
    "MaxAttempts": 5
  },
  "Pdf": {
    "BrowserPath": "",
    "NoSandbox": false,
    "TimeoutSeconds": 30,
    "MaxConcurrent": 2
  },
  "Email": {
    "Mode": "Disabled",
    "From": "dispatch@hellocherie.ch",
    "FromName": "HelloCherie Dispatch",
    "PickupDirectory": "App_Data/mail",
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls",
    "SmtpUsername": "",
    "SmtpPassword": "",
    "PollSeconds": 15,
    "WorkerEnabled": true
  }
}
